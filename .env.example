# Switch Fiber Environment Configuration

# Backend API base URL used by the Vercel serverless proxy in api/ and by the
# Vite dev proxy. Set this in the Vercel project settings for production.
BACKEND_API_URL=https://103.249.198.43:8090

# Confirmation email (Resend — https://resend.com, free tier 3,000/mo).
# Leave RESEND_API_KEY unset to disable emails; submissions still work.
# Sender domain is harmonyitc.com — it must show as "Verified" under
# Resend → Domains (add the DKIM/SPF records Resend lists to the domain's DNS
# host) before applicant emails deliver. Until then, use
# "Switch Fiber <onboarding@resend.dev>" (delivers only to the Resend account
# owner's inbox — test mode).
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Switch Fiber <noreply@harmonyitc.com>"

# Origin used for the tracking link inside the email.
SITE_URL=https://switchfiber.ph
